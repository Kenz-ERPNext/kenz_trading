 "font_size": 14,
 "html": "{% set company = frappe.get_doc(\"Company\", doc.company) %}\n{% set company_address_name = frappe.db.get_value(\"Dynamic Link\", {\n    \"link_doctype\": \"Company\",\n    \"link_name\": doc.company,\n    \"parenttype\": \"Address\"\n}, \"parent\") %}\n{% set company_address = frappe.get_doc(\"Address\", company_address_name) if company_address_name else None %}\n\n{# Fetch Supplier Document #}\n{% set supplier = frappe.get_doc(\"Supplier\", doc.supplier) if doc.supplier else None %}\n\n{# Fetch Supplier Address Name #}\n{% set supplier_address_name = frappe.db.get_value(\"Dynamic Link\", {\n    \"link_doctype\": \"Supplier\",\n    \"link_name\": doc.supplier,\n    \"parenttype\": \"Address\"\n}, \"parent\") %}\n\n{# Fetch Supplier Address Document #}\n{% set supplier_address = frappe.get_doc(\"Address\", supplier_address_name) if supplier_address_name else None %}\n\n\n\n\n<p style=\"font-size:14px; font-weight:bold; color:#000; text-align:left; \">\n    {{doc.company}}\n</p>\n\n<p style=\"font-size:13px; color:#444; text-align:left; font-weight:bold;\">\n    INDUSTRIAL | ELECTRICAL | PLUMBING | BUILDING | MATE <br>\n    99<br>\n    <b>PH No :</b> +966 567320321 <br>\n    <b>CR No : {{company.custom_cr_no}}</b> <br>\n    <b>VAT No : {{company.tax_id}}</b>\n</p>\n\n<p style=\"font-size:16px; font-weight:700; text-align:center; color:red; margin-top:10px;\">\n    PURCHASE INVOICE\n</p>\n\n<table style=\"width:100%; border-collapse:collapse; margin-top:10px; font-size:14px; \">\n    <tr>\n        <td style=\"font-weight:600; width:16%; color:red;\">INVOICE No</td>\n        <td style=\"width:2%; color:red;\">:</td>\n        <td style=\"width:32%; color:red; font-weight:bold;\">{{doc.name}}</td>\n        \n        <td style=\"font-weight:600; width:15%; color:red;\">Bill To</td>\n        <td style=\"width:2%;\">:</td>\n        <td style=\"width:32%; color:#000; font-weight:bold;\">{{doc.supplier}}</td>\n    </tr>\n\n    <tr>\n        <td style=\"font-weight:600;\">Date</td>\n        <td>:</td>\n        <td>{{ doc.get_formatted(\"posting_date\") }}</td>\n\n        <td style=\"font-weight:600;\">Address</td>\n        <td>:</td>\n        <td>{{ supplier_address.address_line1 if supplier_address else \"\" }}</td>\n    </tr>\n\n    <tr>\n        <td style=\"font-weight:600;\">Ref No</td>\n        <td>:</td>\n        <td>{{doc.bill_no}}</td>\n        \n        <td style=\"font-weight:600;\">VAT No</td>\n        <td>:</td>\n        <td>{{ supplier.tax_id if supplier else \"\" }}</td>\n    </tr>\n</table>\n\n<table width=\"100%\" style=\"border-collapse: collapse; font-size:12px; width:100%; line-height:0.7; border:1px solid black; color:black\">\n    <thead>\n        <tr style=\"font-weight:bold; text-align:center; color:black;\">\n            <th style=\"border:1px solid black; width:5%; color:black;\">S.No</th>\n            <th style=\"border:1px solid black; width:25%; color:black;\">Description</th>\n            <th style=\"border:1px solid black; width:8%; color:black;\">Unit</th>\n            <th style=\"border:1px solid black; width:8%; color:black;\">Qty</th>\n            <th style=\"border:1px solid black; width:8%; color:black;\">Rate</th>\n            <th style=\"border:1px solid black; width:12%; color:black;\">Amount</th>\n            <th style=\"border:1px solid black; width:10%; color:black;\">VAT</th>\n            <!--<th style=\"border:1px solid black; width:10%;\">Discount</th>-->\n            <th style=\"border:1px solid black; width:15%; color:black;\">Total Price</th>\n        </tr>\n    </thead>\n    <tbody>\n    {% for row in doc.items %}\n    <tr style=\"font-weight:bold; color:black; line-height:0.7;\">\n        <td style=\"border:1px solid black; text-align:center;\">{{ loop.index }}</td>\n        <td style=\"border:1px solid black; text-align:left;\">{{ row.item_name }}</td>\n        <td style=\"border:1px solid black; text-align:center;\">{{ row.uom }}</td>\n        <td style=\"border:1px solid black; text-align:right;\">{{ \"%.2f\"|format(row.qty or 0) }}</td>\n        <td style=\"border:1px solid black; text-align:right;\">{{ \"%.2f\"|format(row.rate or 0) }}</td>\n        <td style=\"border:1px solid black; text-align:right;\">{{ \"%.2f\"|format(row.amount or 0) }}</td>\n        <td style=\"border:1px solid black; text-align:right;\">{{ \"%.2f\"|format(row.tax_amount or 0) }}</td>\n        <!--<td style=\"border:1px solid black; text-align:right;\">{{ \"%.2f\"|format(row.margin_rate_or_amount or 0) }}</td>-->\n        <td style=\"border:1px solid black; text-align:right;\">{{ \"%.2f\"|format(row.total_amount or 0) }}</td>\n    </tr>\n    {% endfor %}\n    </tbody>\n</table>\n\n\n\n<table width=\"100%\" \n    style=\"border-collapse: collapse;\n           width:100%;\n           font-size:12px;\n           font-weight:bold;\">\n\n   <tr>\n       <td style=\"width:65%;\">Terms & Conditions</td>\n       <td style=\"width:20%; font-weight:bold;\">Sub Total</td>\n       <td style=\"width:2%;\">:</td>\n       <td style=\"width:15%; text-align:right;\">{{ doc.total }}</td>\n   </tr>\n\n   <tr>\n       <td rowspan=\"3\" style=\"width:65%;\">{{ doc.terms }}</td>\n       <td style=\"font-weight:bold; line-height:0.7;\">Total Tax</td>\n       <td>:</td>\n       <td style=\"text-align:right; line-height:0.7;\">{{ doc.total_taxes_and_charges }}</td>\n   </tr>\n\n   <tr>\n       <td style=\"font-weight:bold; line-height:0.7;\">Total Amount</td>\n       <td>:</td>\n       <td style=\"text-align:right; line-height:0.7;\">{{ doc.rounded_total }}</td>\n   </tr>\n   \n  \n</table>\n\n<table style=\"width:100%; font-weight:bold; font-size:10px\">  \n <tr>\n       <td styel=\"width:50%;\">Prepared By signature / &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\n       &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Received By signature /</td>\n       <!--<td style=\"text-align:right;\"> Received By signature /</td>-->\n   </tr>\n</table>\n\n\n",
